{
    "repo_dir": "/path/to/target/repo",
    "base_branch": "main",
    "ignore_paths": [".github", ".gitignore"],
    "code_extensions": ["go", "js", "java"],
    "output_language": "Spanish",
    "output_path": "./out",
    "output_extension": "md",
    "template_path": "./example-templates/template_a.md",
    "rn_template_path": "./example-templates/rn_template_a.md",
    "debug": false,
    "agents": {
        "condenser": {
            "model": "gemini-2.5-flash"
        },
        "documenter": {
            "model": "gemini-2.5-pro"
        }
    }
}
